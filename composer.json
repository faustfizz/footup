{
    "name": "Footup Framework",
    "description": "FootUp MVC Framework: A Rich Featured LightWeight PHP MVC Framework",
    "keywords": ["MVC", "FootUp Framework", "PHP Framework", "POO"],
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "files": [
            "framework/helpers.php"
        ],
        "psr-4": {
            "Footup\\": "framework/",
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
